diff --git a/apps/ios/App/Sources/ReportSharingView.swift b/apps/ios/App/Sources/ReportSharingView.swift
new file mode 100644
index 0000000..0c8f663
--- /dev/null
+++ b/apps/ios/App/Sources/ReportSharingView.swift
@@ -0,0 +1,195 @@
+import Foundation
+import Observation
+import PDFKit
+import SwiftUI
+
+/// A shareable URL is granted only for the exact prepared file that loaded in the preview.
+/// Toggling optional details invalidates it. Nothing here changes the worker's source records.
+@MainActor
+@Observable
+final class ReportShareSession {
+    @ObservationIgnored private let export: (ReportPrivacyOptions) throws -> URL
+    @ObservationIgnored private let remove: (URL) throws -> Void
+    private(set) var preparedURL: URL?
+    private(set) var previewedURL: URL?
+    private(set) var errorMessage: String?
+    private var pendingCleanup: Set<URL> = []
+
+    init(
+        export: @escaping (ReportPrivacyOptions) throws -> URL,
+        remove: @escaping (URL) throws -> Void = TemporaryExports.removeReport
+    ) {
+        self.export = export
+        self.remove = remove
+    }
+
+    var shareURL: URL? {
+        guard let preparedURL, preparedURL == previewedURL,
+            FileManager.default.fileExists(atPath: preparedURL.path)
+        else { return nil }
+        return preparedURL
+    }
+
+    func prepare(privacy: ReportPrivacyOptions) {
+        discard()
+        do { preparedURL = try export(privacy) } catch {
+            errorMessage =
+                "The report could not be prepared. Your original records are unchanged. Check device storage and retry."
+        }
+    }
+
+    func previewLoaded(_ url: URL) {
+        guard url == preparedURL else { return }
+        previewedURL = url
+    }
+
+    func previewFailed(_ url: URL) {
+        guard url == preparedURL else { return }
+        previewedURL = nil
+        errorMessage =
+            "The report preview could not be opened. Sharing is unavailable; go back and prepare it again."
+    }
+
+    func discard() {
+        if let preparedURL { pendingCleanup.insert(preparedURL) }
+        preparedURL = nil
+        previewedURL = nil
+        errorMessage = nil
+        for url in Array(pendingCleanup) {
+            do {
+                try remove(url)
+                pendingCleanup.remove(url)
+            } catch {
+                errorMessage =
+                    "A temporary report could not be removed. It is no longer available to share here. Retry or use Delete all local data to retry app-owned cleanup."
+            }
+        }
+    }
+}
+
+struct ReportSharingView: View {
+    @Environment(\.dismiss) private var dismiss
+    @State private var privacy = ReportPrivacyOptions()
+    @State private var session: ReportShareSession
+    @State private var showingPreview = false
+
+    init(context: PayPeriodContext) {
+        _session = State(
+            initialValue: ReportShareSession { privacy in
+                guard let calculation = context.calculation else {
+                    throw AppModelError.calculationUnavailable
+                }
+                return try ReconciliationReportExporter().export(
+                    window: context.window, timeZoneIdentifier: context.timeZoneIdentifier,
+                    agreement: context.agreement, calculation: calculation,
+                    paystub: context.paystub, reconciliation: context.reconciliation,
+                    findings: [], privacy: privacy)
+            })
+    }
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section("Choose what to share") {
+                    Text(
+                        "The report contains pay amounts, dates and rule details. It is not anonymous. Check the exact PDF before choosing a recipient."
+                    )
+                    Text(
+                        "By default, OCR source lines, profile identity, source names, URLs and private rule notes are omitted. Original paystub pages and work notes are never included."
+                    )
+                    Toggle(
+                        "Include identifying source details", isOn: $privacy.includeSourceDetails
+                    )
+                    .accessibilityIdentifier("report.include-source-details")
+                    if privacy.includeSourceDetails {
+                        Label(
+                            "Includes profile/source identifiers, URLs, private rule notes and entire OCR source lines. Nearby personal information may be included. Review every page.",
+                            systemImage: "exclamationmark.triangle"
+                        )
+                        .foregroundStyle(LinePayColor.review)
+                    }
+                }
+                Section {
+                    Button("Preview report") {
+                        session.prepare(privacy: privacy)
+                        showingPreview = session.preparedURL != nil
+                    }.frame(minHeight: 48).accessibilityIdentifier("report.preview")
+                    Text(
+                        "Nothing is sent automatically. Sharing creates a copy outside LinePaycheck; deleting local records cannot remove that copy. Your original records are not changed."
+                    )
+                    .font(.footnote)
+                }
+                if let error = session.errorMessage {
+                    Section { Text(error).foregroundStyle(LinePayColor.review) }
+                }
+            }
+            .navigationTitle("Review sharing copy")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("Done") { dismiss() }.accessibilityIdentifier("report.done")
+                }
+            }
+            .navigationDestination(isPresented: $showingPreview) {
+                if let url = session.preparedURL {
+                    ReportPreviewView(url: url, session: session)
+                }
+            }
+        }
+        .onChange(of: privacy) { _, _ in session.discard() }
+        .onDisappear { session.discard() }
+    }
+}
+
+private struct ReportPreviewView: View {
+    let url: URL
+    let session: ReportShareSession
+    @State private var document: PDFDocument?
+
+    var body: some View {
+        VStack(spacing: 0) {
+            Text("Sensitive pay data. Review every page before sharing.")
+                .font(.callout).padding().accessibilityIdentifier("report.preview-warning")
+            if let document {
+                ReportPDFView(document: document).accessibilityIdentifier("report.pdf")
+            } else if let error = session.errorMessage {
+                ContentUnavailableView(
+                    "Preview unavailable", systemImage: "doc", description: Text(error))
+            } else {
+                ProgressView("Opening report")
+            }
+        }
+        .navigationTitle("Report preview")
+        .navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+            ToolbarItem(placement: .primaryAction) {
+                if let shareURL = session.shareURL {
+                    ShareLink("Share report", item: shareURL)
+                        .accessibilityIdentifier("audit.share-report")
+                }
+            }
+        }
+        .task(id: url) {
+            guard let loaded = PDFDocument(url: url), loaded.pageCount > 0 else {
+                session.previewFailed(url)
+                return
+            }
+            document = loaded
+            session.previewLoaded(url)
+        }
+    }
+}
+
+private struct ReportPDFView: UIViewRepresentable {
+    let document: PDFDocument
+    func makeUIView(context: Context) -> PDFView {
+        let view = PDFView()
+        view.autoScales = true
+        view.displayMode = .singlePageContinuous
+        view.document = document
+        return view
+    }
+    func updateUIView(_ view: PDFView, context: Context) {
+        if view.document !== document { view.document = document }
+    }
+}
